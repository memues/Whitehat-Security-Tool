<?xml version="1.0" encoding="utf-8"?>
<!--
  Source manifest for scripts/Build-MsixPackage.ps1. The script substitutes
  version and OS metadata and copies the generated shield assets. Successful
  packaging is development evidence only; restricted capability approval,
  external recovery/removal behavior and VM testing remain release gates.
  See ../../docs/msix-lifecycle-review.md.
-->
<Package
  xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
  xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
  xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
  xmlns:desktop="http://schemas.microsoft.com/appx/manifest/desktop/windows10"
  xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
  IgnorableNamespaces="uap uap10 desktop rescap">

  <!-- Store ID: 9MTVDV7FSJDS
       Expected PFN: omni.apps.WhitehatSecurityTool_mhkhb0gkqyqq8 -->
  <Identity
    Name="omni.apps.WhitehatSecurityTool"
    Publisher="CN=79C00735-EF73-493D-AE6B-36BE09C31052"
    Version="__PACKAGE_VERSION__"
    ProcessorArchitecture="x64" />

  <Properties>
    <DisplayName>Whitehat Security Tool</DisplayName>
    <PublisherDisplayName>omni.apps</PublisherDisplayName>
    <Description>Local Windows security monitoring and user-directed response.</Description>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>

  <Resources>
    <Resource Language="en-US" />
  </Resources>

  <Dependencies>
    <TargetDeviceFamily
      Name="Windows.Desktop"
      MinVersion="__MINIMUM_OS_VERSION__"
      MaxVersionTested="__MAXIMUM_OS_VERSION__" />
  </Dependencies>

  <Applications>
    <!-- Normal launch stays asInvoker. Privileged response remains explicit. -->
    <Application
      Id="WhitehatSecurityTool"
      Executable="WhitehatSecurity.exe"
      EntryPoint="Windows.FullTrustApplication"
      uap10:RuntimeBehavior="packagedClassicApp"
      uap10:TrustLevel="mediumIL">
      <uap:VisualElements
        DisplayName="Whitehat Security Tool"
        Description="Local Windows security monitoring and user-directed response."
        BackgroundColor="transparent"
        Square150x150Logo="Assets\Square150x150Logo.png"
        Square44x44Logo="Assets\Square44x44Logo.png" />

      <Extensions>
        <!-- Disabled until the user enables it in Windows Startup Settings.
             Windows owns this preference, including disabled-by-user state. -->
        <desktop:Extension
          Category="windows.startupTask"
          Executable="WhitehatSecurity.exe"
          EntryPoint="Windows.FullTrustApplication"
          uap10:Parameters="--silent">
          <desktop:StartupTask
            TaskId="WhitehatSecurityToolStartup"
            Enabled="false"
            DisplayName="Whitehat Security Tool" />
        </desktop:Extension>
      </Extensions>
    </Application>
  </Applications>

  <Capabilities>
    <!-- Proposed, subject to Microsoft review. Declaring capabilities neither
         grants Store approval nor replaces UAC for privileged user actions. -->
    <rescap:Capability Name="runFullTrust" />
    <rescap:Capability Name="allowElevation" />
  </Capabilities>
</Package>
